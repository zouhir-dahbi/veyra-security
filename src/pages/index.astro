---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { serviceAreas } from '../data/serviceAreas';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const pillars = [
  ['Smart Home', 'Make your devices work together.', '/smart-home', '/images/AdobeStock_1760958129.jpeg', 'Homeowner controlling a smart-home device from a phone'],
  ['Wi-Fi & Networking', 'Reliable connectivity throughout your property.', '/wifi-networking', '/images/AdobeStock_2117320883.jpeg', 'Technician terminating structured network cabling'],
  ['Security', 'Professional cameras and connected security.', '/security', '/images/AdobeStock_1282055483.jpeg', 'Professionally installed security camera'],
  ['Installation', 'Clean installation without the DIY frustration.', '/installation', '/images/AdobeStock_1829282770.jpeg', 'Technician mounting equipment on a wall'],
];

const problems = [
  ["Wi-Fi doesn't reach part of the house", '/wifi-networking'],
  ["Bought cameras but don't want to install them", '/security'],
  ['Need Ethernet in an office or room', '/wifi-networking#ethernet'],
  ['Want a TV mounted with clean cable management', '/installation'],
  ["Smart devices won't stay connected", '/smart-home'],
  ['Need cameras upgraded or replaced', '/security#upgrades'],
  ['Bought a smart lock or video doorbell', '/smart-home#locks-doorbells'],
  ['Want several technology projects handled in one visit', '/installation'],
];

const homeFaqs = [
  { q: 'Do you work with both homeowners and small businesses?', a: 'Yes. We design residential and small-business projects as two distinct services — a home and a small business have very different needs, and we plan for each accordingly.' },
  { q: 'Do I need to know what equipment I want before contacting you?', a: "No. Tell us the problem, not the product — we ask about your property and priorities in plain language and recommend equipment from there." },
  { q: 'Can you handle Wi-Fi, cameras, and installation in the same visit?', a: 'Yes — many customers have a list of technology tasks. Tell us what you need and we\'ll plan the visit around it.' },
  { q: 'What areas do you serve?', a: `We serve homeowners and small businesses throughout Northern Virginia. <a href="${withBase('/service-areas')}" class="text-primary hover:underline">See our full list of service areas</a>.` },
];
---

<BaseLayout
  title="Veyra Home Technology | Smart Home, Wi-Fi, Security & Installation in Northern Virginia"
  description="Veyra Home Technology plans, installs, configures, and tests smart-home, Wi-Fi and networking, security, and technology installation projects for homes and small businesses throughout Northern Virginia."
>
  <!-- Hero (light) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
    <div class="container mx-auto px-4 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="eyebrow">{site.tagline}</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-tight text-ink mb-6 animate-fade-in">
            Professional Home Technology, <span class="text-primary">Installed Properly</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 mb-4 max-w-xl animate-fade-in-delay">
            We install, connect, configure, and troubleshoot technology throughout homes and small businesses across Northern Virginia.
          </p>
          <p class="text-base md:text-lg text-primary font-medium mb-8 max-w-xl animate-fade-in-delay">
            Thoughtfully planned. Cleanly installed. Properly configured. Thoroughly tested.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-delay-2">
            <a href={withBase('/contact')} class="btn-primary text-lg px-8 py-4">Request Service</a>
            <a href={withBase('/services')} class="btn-outline text-lg px-8 py-4">Explore Services</a>
          </div>
        </div>
        <div class="relative animate-fade-in">
          <img src={withBase('/images/AdobeStock_2103632686.jpeg')} alt="Professionally installed security camera on a modern home" class="rounded-2xl shadow-card-hover w-full" />
          <div class="absolute -bottom-5 -left-5 bg-white rounded-xl shadow-card-hover p-4 hidden md:flex items-center gap-3">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="font-bold text-ink">Our Process</div>
              <div class="text-sm text-slate-500">Assessment to Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Four pillars (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">What We Do</h2>
        <p class="text-slate-600 text-lg">Four areas, one team — from the first walkthrough to long-term support.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {pillars.map(([title, body, href, img, alt]) => (
          <a href={withBase(href)} class="card card-hover overflow-hidden group">
            <div class="relative h-40 overflow-hidden">
              <img src={withBase(img)} alt={alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-lg text-ink mb-1">{title}</h3>
              <p class="text-sm text-slate-600">{body}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Residential vs Small Business (light gray) -->
  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Wherever You Need Us</h2>
        <p class="text-slate-600 text-lg">We plan technology around how you actually live and work — not a one-size-fits-all box of devices.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-56 overflow-hidden">
            <img src={withBase('/images/AdobeStock_769078732.jpeg')} alt="Homeowner unlocking a smart lock with a phone" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">For Your Home</h3>
            <p class="text-slate-600 mb-6">Smart home, Wi-Fi, security, and installation projects designed around your property and how you want to manage them.</p>
            <a href={withBase('/services')} class="btn-outline">Explore Services</a>
          </div>
        </div>
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-56 overflow-hidden">
            <img src={withBase('/images/AdobeStock_2121774243.jpeg')} alt="Employee badging in at an access-control reader" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">For Your Business</h3>
            <p class="text-slate-600 mb-6">Networking, cameras, and installation designed around your property, operations, and growth.</p>
            <a href={withBase('/small-business')} class="btn-outline">Small Business</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem-based section (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Need Help With Your Home Technology?</h2>
        <p class="text-slate-600 text-lg">You don't need to know the technical name for it — just tell us the problem.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {problems.map(([label, href]) => (
          <a href={withBase(href)} class="card card-hover p-5 flex items-center gap-3">
            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            <span class="text-sm font-medium text-ink">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Multi-service visit (light gray) -->
  <section class="bg-slate-50 py-16">
    <div class="container mx-auto px-4 text-center max-w-2xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-ink mb-3">Have a List? We'll Work Through It.</h2>
      <p class="text-slate-600">TV mounting, a smart lock, Wi-Fi troubleshooting, a video doorbell, and cable cleanup — many customers have several technology tasks at once. Tell us what's on your list and we'll plan the visit around it.</p>
    </div>
  </section>

  <!-- Process (dark accent) -->
  <ProcessSteps dark={true} />

  <!-- Service areas (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Serving Northern Virginia</h2>
        <p class="text-slate-600 text-lg">Smart home, Wi-Fi, security, and installation services across our Northern Virginia service territory.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto mb-10">
        {serviceAreas.map((a) => (
          <a href={withBase(`/service-areas/${a.slug}`)} class="area-tag">{a.city}</a>
        ))}
      </div>
      <div class="text-center">
        <a href={withBase('/service-areas')} class="text-primary font-semibold hover:text-primary-dark inline-flex items-center gap-2">
          View All Service Areas
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust placeholder (light gray) -->
  <section class="bg-slate-50 py-16">
    <div class="container mx-auto px-4">
      <div class="empty-state max-w-3xl mx-auto">
        <p class="font-semibold text-slate-700 mb-1">Licensing, insurance, and review information</p>
        <p class="text-sm">This section will display verified credentials and customer reviews once available. We do not publish unverified trust claims.</p>
      </div>
    </div>
  </section>

  <!-- FAQ (white) -->
  <FaqAccordion faqs={homeFaqs} />

  <!-- CTA -->
  <CtaBanner
    heading="Tell us what you're trying to accomplish."
    sub="No pressure, no fixed package — just a plan for your property."
  />
</BaseLayout>
