---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { serviceAreas } from '../data/serviceAreas';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const services = [
  ['Security Cameras', 'PoE camera systems, NVR recording, remote viewing', '/services#cameras',
    'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'],
  ['Access Control', 'Electronic entry, mobile credentials, entry history', '/services#access-control',
    'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'],
  ['System Upgrades', 'Modernize or replace aging, unreliable equipment', '/services#upgrades',
    'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15'],
  ['Maintenance & Support', 'Ongoing reliability for systems already in place', '/services#maintenance',
    'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z'],
  ['Security Assessments', "A clear, no-pressure look at your property's needs", '/services#assessments',
    'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'],
];

const homeFaqs = [
  { q: 'Do you work with both homeowners and businesses?', a: 'Yes. We design residential and commercial systems as two distinct services — a home and a small business have very different coverage, access, and support needs, and we plan for each accordingly.' },
  { q: 'Do I need to know what equipment I want before contacting you?', a: "No. The security assessment exists precisely so you don't need to know camera models or door-controller specs ahead of time — we ask about your property and priorities in plain language and design the system from there." },
  { q: 'Can you upgrade or replace an existing camera system?', a: "Yes — modernizing aging or unreliable equipment is a core part of what we do, for both homes and businesses. We'll assess what you have before recommending what to replace." },
  { q: 'What areas do you serve?', a: `We serve homeowners and businesses throughout Northern Virginia. <a href="${withBase('/service-areas')}" class="text-primary hover:underline">See our full list of service areas</a>.` },
];
---

<BaseLayout
  title="Veyra Security Systems | Professional Security Cameras & Access Control in Northern Virginia"
  description="Veyra Security Systems designs, installs, and supports professional security camera and access-control systems for homes and businesses throughout Northern Virginia."
>
  <!-- Hero (light) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
    <div class="container mx-auto px-4 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="eyebrow">Northern Virginia</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-tight text-ink mb-6 animate-fade-in">
            Professional Security Systems <span class="text-primary">for Homes &amp; Businesses</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 mb-4 max-w-xl animate-fade-in-delay">
            Security cameras, access control, system upgrades, and professional support throughout Northern Virginia.
          </p>
          <p class="text-base md:text-lg text-primary font-medium mb-8 max-w-xl animate-fade-in-delay">
            Thoughtfully designed. Cleanly installed. Properly configured. Thoroughly tested.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-delay-2">
            <a href={withBase('/contact')} class="btn-primary text-lg px-8 py-4">Schedule a Security Assessment</a>
            <a href={withBase('/services')} class="btn-outline text-lg px-8 py-4">Explore Our Services</a>
          </div>
        </div>
        <div class="relative animate-fade-in">
          <img src={withBase('/images/AdobeStock_2103632686.jpeg')} alt="Professionally installed security camera on a modern building" class="rounded-2xl shadow-card-hover w-full" />
          <div class="absolute -bottom-5 -left-5 bg-white rounded-xl shadow-card-hover p-4 hidden md:flex items-center gap-3">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="font-bold text-ink">7-Step Process</div>
              <div class="text-sm text-slate-500">Assessment to Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two paths (light gray) -->
  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Wherever You Need Us</h2>
        <p class="text-slate-600 text-lg">We build security systems around how you actually live and work — not a one-size-fits-all box of devices.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-56 overflow-hidden">
            <img src={withBase('/images/AdobeStock_1760958129.jpeg')} alt="Homeowner unlocking a smart lock with a phone" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">For Your Home</h3>
            <p class="text-slate-600 mb-6">Professional security solutions designed around your property, coverage needs, and how you want to manage your system.</p>
            <a href={withBase('/residential')} class="btn-outline">Residential Security</a>
          </div>
        </div>
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-56 overflow-hidden">
            <img src={withBase('/images/AdobeStock_2121774243.jpeg')} alt="Employee badging in at an access-control reader" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">For Your Business</h3>
            <p class="text-slate-600 mb-6">Professional camera and access-control systems designed around your property, operations, employees, and future growth.</p>
            <a href={withBase('/commercial')} class="btn-outline">Commercial Security</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship: Cameras & Access Control (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Cameras <span class="text-primary">and</span> Access Control</h2>
        <p class="text-slate-600 text-lg">Two core systems, professionally installed and configured — and designed to work together.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-64 overflow-hidden">
            <img src={withBase('/images/AdobeStock_1282055483.jpeg')} alt="Professionally installed security camera" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">Security Cameras</h3>
            <p class="text-slate-600 mb-6">PoE camera systems with reliable local recording, remote viewing, and coverage planned around your property — indoors and out.</p>
            <a href={withBase('/services#cameras')} class="btn-outline">Explore Cameras</a>
          </div>
        </div>
        <div class="card card-hover overflow-hidden group">
          <div class="relative h-64 overflow-hidden">
            <img src={withBase('/images/AdobeStock_769078732.jpeg')} alt="Unlocking a smart door lock with a mobile phone" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <h3 class="font-display font-bold text-2xl text-ink mb-3">Access Control &amp; Smart Locks</h3>
            <p class="text-slate-600 mb-6">Electronic entry, smart locks, and mobile credentials — so you control who comes and goes, from a single door to a whole building.</p>
            <a href={withBase('/services#access-control')} class="btn-outline">Explore Access Control</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services overview (light gray) -->
  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">What We Do</h2>
        <p class="text-slate-600 text-lg">One team, from the first walkthrough to long-term support.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {services.map(([title, body, href, icon]) => (
          <a href={withBase(href)} class="card card-hover p-6 text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon} /></svg>
            </div>
            <h3 class="font-semibold text-ink mb-2">{title}</h3>
            <p class="text-sm text-slate-600">{body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process (dark accent) -->
  <ProcessSteps dark={true} />

  <!-- Service areas (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Serving Northern Virginia</h2>
        <p class="text-slate-600 text-lg">Professional residential and commercial security services across our Northern Virginia service territory.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto mb-10">
        {serviceAreas.map((a) => (
          <a href={withBase(`/service-areas/${a.slug}`)} class="area-tag">{a.city}</a>
        ))}
      </div>
      <div class="text-center">
        <a href={withBase('/service-areas')} class="text-primary font-semibold hover:text-primary-dark inline-flex items-center gap-2">
          View All Service Areas
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust placeholder (light gray) -->
  <section class="bg-slate-50 py-16">
    <div class="container mx-auto px-4">
      <div class="empty-state max-w-3xl mx-auto">
        <p class="font-semibold text-slate-700 mb-1">Licensing, insurance, and review information</p>
        <p class="text-sm">This section will display verified credentials and customer reviews once available. We do not publish unverified trust claims.</p>
      </div>
    </div>
  </section>

  <!-- FAQ (white) -->
  <FaqAccordion faqs={homeFaqs} />

  <!-- CTA -->
  <CtaBanner
    heading="Ready to see what a professional system looks like on your property?"
    sub="Schedule a no-pressure security assessment and we'll walk you through exactly what we'd recommend and why."
  />
</BaseLayout>
