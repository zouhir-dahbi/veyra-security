---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const beliefs = [
  ['No Scare Tactics', "We talk about reliability, connectivity, and control — not manufactured fear."],
  ['Real Assessments', 'Every recommendation starts with looking at your actual property, not a generic package.'],
  ['Clean Documentation', "You should be able to understand what was installed and how it's configured."],
  ['Support That Continues', "Install day isn't the finish line — ongoing reliability is the goal."],
];
---

<BaseLayout
  title="About Us | Veyra Home Technology"
  description="Veyra Home Technology designs, installs, configures, tests, documents, and supports smart-home, Wi-Fi, security, and technology installation projects throughout Northern Virginia."
>
  <PageHeader
    title="About Veyra Home Technology"
    sub="We design, install, configure, test, document, and support smart-home, Wi-Fi, security, and installation projects for homes and small businesses throughout Northern Virginia."
  />

  <section class="bg-white py-20">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="font-display font-bold text-3xl text-ink mb-4">Why We Exist</h2>
        <p class="text-slate-600 mb-4">Most people encounter home technology in one of two ways: an expensive, opaque vendor, or a box of consumer devices they have to figure out themselves. We built Veyra Home Technology to be the option in between — a local team that treats a home the same way it treats a small business: with a real assessment, a real plan, and a real installation, not a one-size-fits-all package.</p>
        <p class="text-slate-600">We work the same disciplined process on every property — assessment, design, installation, configuration, testing, documentation, and support — so the outcome doesn't depend on luck, whether the job is a single TV mount or a whole-home network.</p>
      </div>
      <img src={withBase('/images/AdobeStock_1829282770.jpeg')} alt="Technician installing equipment with a homeowner nearby" class="rounded-2xl w-full shadow-card" />
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <h2 class="font-display font-bold text-3xl text-ink mb-10 text-center">What We Believe</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {beliefs.map(([title, body]) => (
          <div class="card p-6">
            <h3 class="font-semibold text-ink mb-2">{title}</h3>
            <p class="text-sm text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="font-display font-bold text-3xl text-ink mb-4">Built to Grow With Northern Virginia</h2>
      <p class="text-slate-600">Veyra Home Technology is focused today on smart-home devices, Wi-Fi and networking, security cameras, and technology installation — for homeowners and small businesses throughout our Northern Virginia service area. As the region grows, we intend to grow with it.</p>
    </div>
  </section>

  <CtaBanner heading="Have a property in mind?" />
</BaseLayout>
