---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const beliefs = [
  ['No Scare Tactics', 'We talk about visibility, control, and reliability — not manufactured fear.'],
  ['Real Assessments', 'Every recommendation starts with looking at your actual property, not a generic package.'],
  ['Clean Documentation', "You should be able to understand what was installed and how it's configured."],
  ['Support That Continues', "Install day isn't the finish line — ongoing reliability is the goal."],
];
---

<BaseLayout
  title="About Us | Veyra Security Systems"
  description="Veyra Security Systems designs, installs, configures, tests, documents, and supports professional security camera and access-control systems throughout Northern Virginia."
>
  <PageHeader
    title="About Veyra Security Systems"
    sub="We design, install, configure, test, document, and support professional security camera and access-control systems for homes and businesses throughout Northern Virginia."
  />

  <section class="bg-white py-20">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="font-display font-bold text-3xl text-ink mb-4">Why We Exist</h2>
        <p class="text-slate-600 mb-4">Most people encounter security cameras and access control in one of two ways: an expensive, opaque commercial vendor, or a box of consumer cameras they have to configure themselves. We built Veyra Security Systems to be the option in between — a local team that treats a home the same way it treats a business: with a real assessment, a real design, and a real installation, not a one-size-fits-all package.</p>
        <p class="text-slate-600">We work the same seven-step process on every property — assessment, design, installation, configuration, testing, documentation, and support — so the outcome doesn't depend on luck.</p>
      </div>
      <img src={withBase('/images/AdobeStock_1829282770.jpeg')} alt="Technician installing a security camera with a homeowner nearby" class="rounded-2xl w-full shadow-card" />
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <h2 class="font-display font-bold text-3xl text-ink mb-10 text-center">What We Believe</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {beliefs.map(([title, body]) => (
          <div class="card p-6">
            <h3 class="font-semibold text-ink mb-2">{title}</h3>
            <p class="text-sm text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="font-display font-bold text-3xl text-ink mb-4">Built to Grow With Northern Virginia</h2>
      <p class="text-slate-600">Veyra Security Systems is focused today on security cameras, access control, system upgrades, maintenance, and assessments — for homeowners and businesses throughout our Northern Virginia service area. As the region grows, we intend to grow with it.</p>
    </div>
  </section>

  <CtaBanner heading="Have a property in mind?" />
</BaseLayout>
