---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/small-business`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to Small Business | Veyra Home Technology</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This page has moved. <a href={target}>Continue to Small Business</a>.</p>
  </body>
</html>
