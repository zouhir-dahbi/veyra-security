---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Projects | Veyra Security Systems"
  description="A look at security camera and access-control projects completed by Veyra Security Systems throughout Northern Virginia."
>
  <PageHeader
    title="Projects"
    sub="A look at the residential and commercial security systems we've designed and installed."
  />

  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="empty-state max-w-2xl mx-auto">
        <p class="font-semibold text-slate-700 mb-1">Project case studies coming soon</p>
        <p class="text-sm">We publish project write-ups only after real installations are complete and the customer is comfortable being featured. Check back soon, or <a href={`${base}/contact`} class="text-primary hover:underline">schedule an assessment</a> to be one of our first.</p>
      </div>
    </div>
  </section>
</BaseLayout>
