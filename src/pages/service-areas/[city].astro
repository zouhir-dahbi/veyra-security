---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { serviceAreas } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { city: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const nearby = area.nearby
  .map((slug) => serviceAreas.find((a) => a.slug === slug))
  .filter(Boolean) as typeof serviceAreas;
---

<BaseLayout
  title={`Home Technology Installation in ${area.city}, VA | Veyra Home Technology`}
  description={area.metaDescription}
>
  <PageHeader
    eyebrow={`Serving ${area.city}`}
    title={`Home Technology for ${area.city}, VA`}
    sub={area.intro}
  />

  <!-- Residential + Commercial (white) -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4 grid md:grid-cols-2 gap-8">
      <div class="card p-8">
        <h2 class="font-display font-bold text-2xl text-ink mb-3">Residential Technology in {area.city}</h2>
        <p class="text-slate-600 mb-6">{area.residential}</p>
        <a href={withBase('/services')} class="btn-outline">Explore Services</a>
      </div>
      <div class="card p-8">
        <h2 class="font-display font-bold text-2xl text-ink mb-3">Small Business Technology in {area.city}</h2>
        <p class="text-slate-600 mb-6">{area.commercial}</p>
        <a href={withBase('/small-business')} class="btn-outline">Small Business</a>
      </div>
    </div>
  </section>

  <!-- What we install (light gray) -->
  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card p-6">
        <h3 class="font-display font-semibold text-xl text-ink mb-2">Smart Home</h3>
        <p class="text-slate-600 text-sm mb-4">Smart locks, doorbells, thermostats, and lighting, installed and configured to work together for {area.city} homes.</p>
        <a href={withBase('/smart-home')} class="text-primary text-sm font-semibold hover:underline">Smart home &rarr;</a>
      </div>
      <div class="card p-6">
        <h3 class="font-display font-semibold text-xl text-ink mb-2">Wi-Fi &amp; Networking</h3>
        <p class="text-slate-600 text-sm mb-4">Whole-home Wi-Fi, dead-zone correction, and Ethernet planned around how a {area.city} property is actually laid out.</p>
        <a href={withBase('/wifi-networking')} class="text-primary text-sm font-semibold hover:underline">Wi-Fi &amp; networking &rarr;</a>
      </div>
      <div class="card p-6">
        <h3 class="font-display font-semibold text-xl text-ink mb-2">Security</h3>
        <p class="text-slate-600 text-sm mb-4">From a single entry point to full property coverage, we plan camera placement around how a {area.city} home or business is actually used.</p>
        <a href={withBase('/security')} class="text-primary text-sm font-semibold hover:underline">Security &rarr;</a>
      </div>
      <div class="card p-6">
        <h3 class="font-display font-semibold text-xl text-ink mb-2">Installation</h3>
        <p class="text-slate-600 text-sm mb-4">TV mounting, cable management, and clean technology installation for {area.city} homes and businesses.</p>
        <a href={withBase('/installation')} class="text-primary text-sm font-semibold hover:underline">Installation &rarr;</a>
      </div>
    </div>
  </section>

  <ProcessSteps dark={true} heading={`Our Process in ${area.city}`} subheading="The same disciplined process for every property, residential or commercial." />

  <!-- Areas served (white) -->
  {nearby.length > 0 && (
    <section class="bg-white py-16">
      <div class="container mx-auto px-4 text-center max-w-2xl">
        <h2 class="font-display font-bold text-2xl text-ink mb-3">Areas Served Near {area.city}</h2>
        <p class="text-slate-600 mb-6">
          We also serve homeowners and businesses in {nearby.map((n, i) => (
            <>{i > 0 && ' and '}<a href={withBase(`/service-areas/${n.slug}`)} class="text-primary hover:underline">{n.city}</a></>
          ))}. See our full <a href={withBase('/service-areas')} class="text-primary hover:underline">Northern Virginia service area</a>.
        </p>
      </div>
    </section>
  )}

  <FaqAccordion heading={`${area.city} FAQ`} faqs={area.faqs} />

  <CtaBanner heading={`Request Service in ${area.city}`} sub="Tell us about your property and we'll walk you through exactly what we'd recommend and why — no pressure, no fixed package." />
</BaseLayout>
