---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Resources | Veyra Security Systems"
  description="Guides and answers about security cameras, access control, and system upgrades for homes and businesses in Northern Virginia."
>
  <PageHeader
    title="Resources"
    sub="Straightforward guides on security cameras, access control, and system upgrades — for homeowners and business owners alike."
  />

  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="empty-state max-w-2xl mx-auto">
        <p class="font-semibold text-slate-700 mb-1">Guides coming soon</p>
        <p class="text-sm">We're building out plain-language guides on choosing camera coverage, understanding storage options, and planning access control. In the meantime, <a href={`${base}/contact`} class="text-primary hover:underline">schedule an assessment</a> and ask us directly.</p>
      </div>
    </div>
  </section>
</BaseLayout>
