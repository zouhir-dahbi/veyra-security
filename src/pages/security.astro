---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const outcomes = [
  ['Visibility', "Know what's happening around your property."],
  ['Control', 'View and manage cameras from anywhere.'],
  ['Reliability', 'Coverage that works when you need it to.'],
  ['Professional Install', 'Planned, wired, and tested by someone who does this daily.'],
];

const faqs = [
  { q: 'How many cameras does a typical home need?', a: "It depends entirely on your property — lot size, entry points, and what you actually want visibility on. That's exactly what the assessment is for; we don't recommend a fixed number before seeing your property." },
  { q: 'Do I need a subscription to view my cameras remotely?', a: "We'll walk you through local versus cloud storage options and what each involves during your assessment, so you can decide what fits your property and budget." },
  { q: 'Can you replace my old DIY cameras with a real system?', a: "Yes — this is one of the most common upgrades we do. We'll assess your existing setup and recommend what to keep, replace, or rewire." },
  { q: 'Do you offer 24/7 monitoring?', a: "We don't currently provide alarm-style monitoring. We install cameras and access control so you can view and respond to your own property, with recording and remote access built in." },
];
---

<BaseLayout
  title="Security Cameras & Smart Security | Veyra Home Technology"
  description="Professionally installed security cameras, PoE camera systems, camera upgrades, and smart security for homes and small businesses in Northern Virginia."
>
  <PageHeader
    eyebrow="Security"
    title="Professional Cameras & Connected Security"
    sub="A professionally installed system you can actually rely on — not a pile of disconnected DIY devices. Visibility and control, without the fear-based sales pitch."
  />

  <!-- Outcomes (white) -->
  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {outcomes.map(([title, body]) => (
          <div>
            <h3 class="font-display font-semibold text-lg text-ink mb-1">{title}</h3>
            <p class="text-sm text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cameras (light gray) -->
  <section id="cameras" class="bg-slate-50 py-20 scroll-mt-24">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Security Cameras</h2>
        <p class="text-slate-600 mb-6">Whether you're covering a front door, a driveway, a garage, or a full perimeter, we plan camera placement around how you actually use the property — then install it cleanly and configure it correctly.</p>
        <ul class="mb-8">
          <li class="feature-item">Outdoor &amp; indoor security cameras</li>
          <li class="feature-item">Door, entry, and driveway coverage</li>
          <li class="feature-item">Video doorbells</li>
          <li class="feature-item">Remote and mobile viewing</li>
        </ul>
        <a href={withBase('/contact?type=residential')} class="btn-primary">Request Service</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img src={withBase('/images/AdobeStock_1659686480.jpeg')} alt="Outdoor security camera on a home at dusk" class="rounded-2xl w-full h-full object-cover shadow-card" />
        <img src={withBase('/images/AdobeStock_139050781.jpeg')} alt="Remote camera viewing on a tablet" class="rounded-2xl w-full h-full object-cover shadow-card" />
      </div>
    </div>
  </section>

  <!-- PoE systems (white) -->
  <section id="poe-systems" class="bg-white py-20 scroll-mt-24">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div class="order-2 lg:order-1">
        <img src={withBase('/images/AdobeStock_1282055483.jpeg')} alt="Professionally installed PoE security camera" class="rounded-2xl w-full shadow-card" />
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">PoE Camera Systems</h2>
        <p class="text-slate-600 mb-6">Power-over-Ethernet camera systems with local NVR recording, planned and wired for reliability — coverage designed around your property first, then equipment selected to match.</p>
        <ul class="mb-8">
          <li class="feature-item">PoE camera systems &amp; NVR recording</li>
          <li class="feature-item">Video storage planning</li>
          <li class="feature-item">Clean PoE cabling &amp; equipment organization</li>
        </ul>
        <a href={withBase('/contact?type=residential')} class="btn-outline">Request Service</a>
      </div>
    </div>
  </section>

  <!-- Upgrades (light gray) -->
  <section id="upgrades" class="bg-slate-50 py-20 scroll-mt-24">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Camera Upgrades</h2>
        <p class="text-slate-600 mb-6">Already have cameras that are unreliable, poorly placed, or simply outdated? We assess what's there first, then recommend what's worth keeping versus replacing.</p>
        <ul class="mb-8">
          <li class="feature-item">Existing camera system replacement</li>
          <li class="feature-item">Additional camera installation</li>
          <li class="feature-item">Rewiring &amp; PoE conversions</li>
          <li class="feature-item">Storage &amp; recording upgrades</li>
        </ul>
        <a href={withBase('/contact?type=residential')} class="btn-outline">Request Service</a>
      </div>
      <img src={withBase('/images/AdobeStock_1829282770.jpeg')} alt="Technician installing a security camera" class="rounded-2xl w-full shadow-card" />
    </div>
  </section>

  <!-- Smart security (white) -->
  <section id="smart-security" class="bg-white py-20 scroll-mt-24">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div class="order-2 lg:order-1">
        <img src={withBase('/images/AdobeStock_2121774243.jpeg')} alt="Access control reader at an entry door" class="rounded-2xl w-full shadow-card" />
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Smart Security</h2>
        <p class="text-slate-600 mb-6">Where it makes sense for your property, we plan and install smart locks and electronic entry alongside your cameras — so cameras, locks, and doorbells work as one system instead of separate apps.</p>
        <ul class="mb-8">
          <li class="feature-item">Smart locks &amp; electronic entry</li>
          <li class="feature-item">Access management &amp; entry history</li>
          <li class="feature-item">Integration with cameras &amp; video doorbells</li>
        </ul>
        <p class="text-sm text-slate-500">We evaluate what's appropriate during the assessment — not every property needs or benefits from electronic access control.</p>
      </div>
    </div>
  </section>

  <ProcessSteps dark={true} heading="Every Property Gets the Same Process" subheading="Assessment to support — the same disciplined steps every time." />

  <FaqAccordion heading="Security FAQ" faqs={faqs} />

  <CtaBanner heading="See exactly what we'd recommend for your property." href="/contact?type=residential" />
</BaseLayout>
