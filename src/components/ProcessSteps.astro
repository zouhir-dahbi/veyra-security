---
interface Props {
  dark?: boolean;
  heading?: string;
  subheading?: string;
}
const {
  dark = false,
  heading = 'How We Work',
  subheading = 'The same disciplined process for every property, residential or commercial.',
} = Astro.props;

const steps = [
  ['Assessment', 'We walk the property and talk through what matters to you.'],
  ['Design', 'A coverage and equipment plan built for your space, not a generic package.'],
  ['Installation', 'Clean, professional installation — wiring included, nothing left dangling.'],
  ['Configuration', 'Recording, storage, remote access, and users set up correctly the first time.'],
  ['Testing', 'Every camera and access point verified before we call it done.'],
  ['Documentation', "You get a clear record of what was installed and how it's configured."],
  ['Support', 'Ongoing help when you need it — not disappearing after install day.'],
];
---

<section class:list={[dark ? 'bg-ink text-white' : 'bg-slate-50', 'py-20']}>
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class:list={['font-display font-bold text-3xl md:text-4xl mb-4', dark ? 'text-white' : 'text-ink']}>{heading}</h2>
      <p class:list={[dark ? 'text-slate-300' : 'text-slate-600', 'text-lg']}>{subheading}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map(([title, body], i) => (
        <div class:list={[dark ? 'card-dark' : 'card', 'p-6']}>
          <div class:list={['step-number', dark && 'bg-primary/20 text-primary-light']}>{i + 1}</div>
          <h3 class:list={['font-semibold mb-1', dark ? 'text-white' : 'text-ink']}>{title}</h3>
          <p class:list={['text-sm', dark ? 'text-slate-400' : 'text-slate-600']}>{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
