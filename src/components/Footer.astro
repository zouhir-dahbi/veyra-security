---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('http') ? href : `${base}${href}`);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-slate-300">
  <div class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <div class="md:col-span-1">
        <a href={withBase('/')} class="inline-flex flex-col leading-none mb-4">
          <span class="font-display font-bold text-2xl text-white tracking-tight">{site.shortName}</span>
          <span class="text-[10px] font-semibold text-primary-light tracking-[0.2em] uppercase">Home Technology</span>
        </a>
        <p class="text-sm text-slate-400">
          Smart home, Wi-Fi, security, and technology installation for homes and small businesses throughout Northern Virginia.
        </p>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/')} class="hover:text-primary-light transition-colors">Home</a></li>
          <li><a href={withBase('/small-business')} class="hover:text-primary-light transition-colors">Small Business</a></li>
          <li><a href={withBase('/service-areas')} class="hover:text-primary-light transition-colors">Service Areas</a></li>
          <li><a href={withBase('/about')} class="hover:text-primary-light transition-colors">About</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Services</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/smart-home')} class="hover:text-primary-light transition-colors">Smart Home</a></li>
          <li><a href={withBase('/wifi-networking')} class="hover:text-primary-light transition-colors">Wi-Fi &amp; Networking</a></li>
          <li><a href={withBase('/security')} class="hover:text-primary-light transition-colors">Security</a></li>
          <li><a href={withBase('/installation')} class="hover:text-primary-light transition-colors">Installation</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Get in Touch</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={site.phoneHref} class="inline-flex items-center gap-2 font-semibold hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="inline-flex items-center gap-2 hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Contact form
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="btn-primary text-sm mt-1">Request Service</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
