---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('http') ? href : `${base}${href}`);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-slate-300">
  <div class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <div class="md:col-span-1">
        <a href={withBase('/')} class="inline-flex mb-4">
          <img src={withBase('/images/vss-horizontal-white-transparent.png')} alt="Veyra Security Systems" class="h-14 w-auto" />
        </a>
        <p class="text-sm text-slate-400">
          Professional security camera and access-control systems for homes and businesses throughout Northern Virginia.
        </p>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/')} class="hover:text-primary-light transition-colors">Home</a></li>
          <li><a href={withBase('/residential')} class="hover:text-primary-light transition-colors">Residential</a></li>
          <li><a href={withBase('/commercial')} class="hover:text-primary-light transition-colors">Commercial</a></li>
          <li><a href={withBase('/service-areas')} class="hover:text-primary-light transition-colors">Service Areas</a></li>
          <li><a href={withBase('/projects')} class="hover:text-primary-light transition-colors">Projects</a></li>
          <li><a href={withBase('/about')} class="hover:text-primary-light transition-colors">About</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Services</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/services#cameras')} class="hover:text-primary-light transition-colors">Security Cameras</a></li>
          <li><a href={withBase('/services#access-control')} class="hover:text-primary-light transition-colors">Access Control</a></li>
          <li><a href={withBase('/services#upgrades')} class="hover:text-primary-light transition-colors">Security System Upgrades</a></li>
          <li><a href={withBase('/services#maintenance')} class="hover:text-primary-light transition-colors">Maintenance &amp; Support</a></li>
          <li><a href={withBase('/services#assessments')} class="hover:text-primary-light transition-colors">Security Assessments</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-white text-lg mb-4">Get in Touch</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={withBase('/contact')} class="inline-flex items-center gap-2 hover:text-primary-light transition-colors">
              <svg class="w-4 h-4 text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Contact form
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="btn-primary text-sm mt-1">Schedule an Assessment</a>
          </li>
        </ul>
        <p class="text-xs text-slate-500 mt-4">Phone and email will be published once finalized.</p>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {year} Veyra Security Systems. All rights reserved.</p>
    </div>
  </div>
</footer>
