---
interface Props {
  heading: string;
  sub?: string;
  href?: string;
  label?: string;
}
const {
  heading,
  sub,
  href = '/contact',
  label = 'Schedule a Security Assessment',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullHref = href.startsWith('http') ? href : `${base}${href}`;
---

<section class="bg-gradient-to-br from-primary to-primary-dark">
  <div class="container mx-auto px-4 py-20 text-center">
    <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4 max-w-3xl mx-auto">{heading}</h2>
    {sub && <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">{sub}</p>}
    <a href={fullHref} class="btn-white text-lg px-8 py-4">{label}</a>
  </div>
</section>
